# Postgres
POSTGRES_DATABASE=CROUStillant
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Analytics Postgres
ANALYTICS_POSTGRES_DATABASE=
ANALYTICS_POSTGRES_USER=
ANALYTICS_POSTGRES_PASSWORD=
ANALYTICS_POSTGRES_HOST=
ANALYTICS_POSTGRES_PORT=5432

# Archive Postgres (distant, cold storage pour les vieilles partitions de
# requests_logs — voir archiver.py). N'est utilisée que par archive_main.py,
# pas par le cycle __main__.py.
ARCHIVE_POSTGRES_DATABASE=
ARCHIVE_POSTGRES_USER=
ARCHIVE_POSTGRES_PASSWORD=
ARCHIVE_POSTGRES_HOST=
ARCHIVE_POSTGRES_PORT=5432
# Nombre de mois de requests_logs à garder en local avant archivage
ARCHIVE_RETENTION_MONTHS=3

# Bot Discord (dPyStatus) — relevé toutes les 5 min par bot_stats_main.py.
# Le conteneur doit être sur le même réseau Docker que croustillant-bot.
DPYSTATUS_URL=http://croustillant-bot:8095/status
DPYSTATUS_TOKEN=

WEBSITES_IDS=

PHOTON_API_URL=
